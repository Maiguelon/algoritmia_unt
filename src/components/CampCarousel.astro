---
import galleries from '../../content/media/galleries.json';
---
<camp-carousel class="camp-carousel" role="region" aria-label="Fotos de Training Camps anteriores" aria-roledescription="carrusel">
  <div class="carousel-viewport" tabindex="0" aria-label="Fotos; usá las flechas o deslizá para recorrerlas">
    {galleries.camp.map(photo => <figure class="camp-slide">
      <div class="camp-image"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/></div>
      <figcaption><div><span class="eyebrow">{photo.edition}</span><strong>{photo.title}</strong></div><a href={photo.sourceUrl} target="_blank" rel="noreferrer">Foto: {photo.credit} ↗</a></figcaption>
    </figure>)}
  </div>
  <div class="carousel-controls" hidden>
    <button type="button" class="button secondary small" data-direction="-1" aria-label="Foto anterior del camp">←</button>
    <output aria-live="polite" aria-atomic="true">1 de {galleries.camp.length}</output>
    <button type="button" class="button secondary small" data-direction="1" aria-label="Foto siguiente del camp">→</button>
  </div>
</camp-carousel>
<script>
  class CampCarousel extends HTMLElement {
    connectedCallback() {
      const viewport = this.querySelector<HTMLElement>('.carousel-viewport');
      const controls = this.querySelector<HTMLElement>('.carousel-controls');
      const output = this.querySelector('output');
      const count = this.querySelectorAll('.camp-slide').length;
      if (!viewport || !controls || !output || !count) return;
      let current = 0;
      let scrollTimer: number;
      const announce = () => { output.textContent = `${current + 1} de ${count}`; };
      const move = (direction: number) => {
        current = (current + direction + count) % count;
        announce();
        viewport.scrollTo({left: current * viewport.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'});
      };
      controls.hidden = false;
      controls.querySelectorAll<HTMLButtonElement>('button').forEach(button => button.addEventListener('click', () => move(Number(button.dataset.direction))));
      viewport.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1);
      });
      viewport.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          current = Math.max(0, Math.min(count - 1, Math.round(viewport.scrollLeft / viewport.clientWidth)));
          announce();
        }, 150);
      }, {passive: true});
    }
  }
  customElements.define('camp-carousel', CampCarousel);
</script>
<style>
  .camp-carousel { display: block; min-width: 0; }
  .carousel-viewport { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); }
  .camp-slide { flex: 0 0 100%; min-width: 0; margin: 0; scroll-snap-align: start; scroll-snap-stop: always; }
  .camp-image { aspect-ratio: 16 / 10; display: grid; place-items: center; background: #e6eaf3; }
  img { width: 100%; height: 100%; min-height: 0; object-fit: contain; display: block; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; padding: 14px 16px; background: white; }
  figcaption strong { display: block; font-size: .95rem; }
  figcaption a { font-size: .75rem; align-self: end; }
  .carousel-controls { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 14px; }
  .carousel-controls[hidden] { display: none; }
  output { font-size: .82rem; font-weight: 750; color: var(--muted); min-width: 48px; text-align: center; }
  .carousel-controls button { min-width: 44px; min-height: 44px; font-size: 1.2rem; }
</style>

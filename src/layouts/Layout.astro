---
import '../styles/club.css';
import SelectionCart from '../components/SelectionCart';
import { problems } from '../lib/data';
interface Props { title?: string; description?: string }
const { title = 'Algoritmia UNT', description = 'Problemas, herramientas y torneos para entrenar programación competitiva en la UNT.' } = Astro.props;
const pathname = Astro.url.pathname;
const navigation = [['/problemas/','Problemas'],['/torneos/','Torneos'],['/apuntes/','Apuntes'],['/seleccion/','Mi selección']];
---
<!doctype html>
<html lang="es-AR">
  <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#2e50db"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-ants-32.png"/><link rel="icon" type="image/png" sizes="64x64" href="/favicon-ants-64.png"/><link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/nunito-sans.woff2" as="font" type="font/woff2" crossorigin/><title>{title === 'Algoritmia UNT' ? title : `${title} · Algoritmia UNT`}</title></head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header"><div class="club-ribbon" aria-hidden="true"></div><div class="container header-inner"><a class="brand" href="/" aria-label="Algoritmia UNT, inicio"><img src="/logo-club.png" alt="" width="69" height="69"/><div><span class="brand-wordmark"><span>Club de</span>Algoritmia</span><small>UNT / FACET · TUCUMÁN</small></div></a><nav class="nav" aria-label="Principal">{navigation.map(([href,label])=><a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav></div></header>
    <main id="contenido"><div class="container"><slot/></div></main>
    {!pathname.startsWith('/seleccion/') && <SelectionCart allowed={problems.map(problem => problem.id)} client:load/>}
    <footer class="footer"><div class="container footer-inner"><div><span class="footer-dots" aria-hidden="true"><i></i><i></i><i></i></span><strong>La práctica se comparte.</strong><br/>Club de Algoritmia · UNT / FACET</div><span>C++17 · Datos con fuentes<br/>Hecho para entrenar juntos, problema a problema.</span></div></footer>
  </body>
</html>

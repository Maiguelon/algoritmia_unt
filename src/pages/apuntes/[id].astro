---
import Layout from '../../layouts/Layout.astro';
import { chunks, sections } from '../../lib/chunks';
export function getStaticPaths() { return chunks.map(chunk => ({ params: { id: chunk.id }, props: { chunk } })); }
const { chunk } = Astro.props;
---
<Layout title={chunk.title}><div class="breadcrumb"><a href="/apuntes/">Apuntes</a> / {chunk.family}</div><div class="page-heading"><span class="eyebrow">{chunk.family} / C++17</span><h1>{chunk.title}</h1><a class="button secondary" href={`/armar/?chunk=${chunk.id}`}>Llevar al apunte ↗</a></div><div class="grid-two"><article class="prose panel">{sections.map(section=><section id={section.id}><h2>{section.label}</h2><div set:html={chunk.html[section.id]}/></section>)}</article><aside><div class="panel"><span class="eyebrow">En esta ficha</span><ul class="note-list">{sections.map(section=><li><a href={`#${section.id}`}>{section.label}</a></li>)}</ul></div>{chunk.suggestedPrerequisites.length > 0 && <div class="panel"><h3>Puede ayudarte</h3><p class="muted">Apoyos para consultar según lo que necesites.</p><ul>{chunk.suggestedPrerequisites.map(id=><li><a href={`/apuntes/${id}/`}>{chunks.find(c=>c.id===id)?.title}</a></li>)}</ul></div>}</aside></div></Layout>

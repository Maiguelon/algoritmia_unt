---
import Layout from '../../layouts/Layout.astro';
import ProblemSelect from '../../components/ProblemSelect';
import { problems, tournaments } from '../../lib/data';
import { chunks } from '../../lib/chunks';
import { tournamentLabel } from '../../lib/tournament-label';
export function getStaticPaths(){return problems.map(problem=>({params:{id:problem.id},props:{problem}}));}
const {problem:p}=Astro.props;
const tournament=tournaments.find(t=>t.id===p.tournamentId)!;
const estimate = (value: string) => value.replace(/\s*\(estimación editorial\)/i, '');
---
<Layout title={p.title}>
  <div class="breadcrumb"><a href="/problemas/">Problemas</a> / <a href={`/torneos/${tournament.id}/`}>{tournamentLabel(tournament)}</a> / {p.letter}</div>
  <div class="page-heading">
    <h1>{p.title}</h1>
    <span class="chip" data-level={p.difficulty}>{p.difficulty}</span>{p.topics.map(topic => <span class="chip">{topic}</span>)}
    <div class="actions">
      <ProblemSelect id={p.id} allowed={problems.map(problem => problem.id)} client:load/>
      {p.judgeUrl && <a class="button secondary" href={p.judgeUrl} target="_blank" rel="noreferrer">Practicar en el juez ↗</a>}
    </div>
  </div>

  <div class="grid-two">
    <div>
      <section class="panel" aria-labelledby="problem-overview-title">
        <h2 id="problem-overview-title">Qué pide este desafío</h2>
        <p><strong>Resumen:</strong> {p.summary}</p>
        <h3>Dificultad estimada</h3>
        <ul>
          <li><strong>Conceptual:</strong> {estimate(p.conceptual)}</li>
          <li><strong>Implementación:</strong> {estimate(p.implementation)}</li>
        </ul>
      </section>
      <section class="panel">
        <h2>Herramientas sugeridas</h2>
        <p class="muted">Cobertura del apunte: <strong>{p.coverage}</strong></p>
        <ul>{p.chunkIds.map(id => <li><a href={`/apuntes/${id}/`}>{chunks.find(chunk => chunk.id === id)?.title}</a></li>)}</ul>
        {p.missingTools.length > 0 && <div class="notice"><strong>Falta cubrir en la biblioteca:</strong><ul>{p.missingTools.map(tool => <li>{tool}</li>)}</ul></div>}
        <div class="actions">
          <a class="button secondary" href="/armar/">Ir al armador ↗</a>
          {p.statementUrl && <a href={p.statementUrl} download>Descargar enunciado ↓</a>}
        </div>
      </section>
      {p.hints.length > 0 && <section class="panel"><h2>Pistas opcionales</h2><p class="muted">Abrí solo lo que necesites. Estas pistas no se agregan al apunte.</p>{p.hints.map((hint, i) => <details><summary>Pista {i + 1}</summary><p>{hint}</p></details>)}</section>}
    </div>
    <aside>
      <section class="panel">
        <span class="eyebrow">Estadísticas del torneo</span>
        <h2 class="problem-completions">{p.ac === null ? 'Sin dato' : `${p.ac}/${p.total}`} {p.ac !== null && <span>completados</span>}</h2>
        {p.firstSolve && <p><strong>Primera resolución:</strong> minuto {p.firstSolve.minute}<br/><small>{p.firstSolve.teams.join(', ')}</small></p>}
        <a href={`/torneos/${tournament.id}/#estadisticas`}>Ver torneo ↗</a>
      </section>
    </aside>
  </div>
</Layout>

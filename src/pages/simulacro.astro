---
import Layout from '../layouts/Layout.astro';
import SimulacroPreview from '../components/SimulacroPreview';
import { problems, tournaments } from '../lib/data';
import { chunks } from '../lib/chunks';
import { BASIC_CHUNK_IDS, notesLevel, presetSelection, recommendedChunkIds } from '../lib/notes-presets';
import '../styles/simulacro.css';

const ids = ['tap-2026-a', 'tap-2026-b', 'tap-2026-c', 'regional-2023-d', 'regional-2025-e'];
const set = ids.map(id => {
  const problem = problems.find(item => item.id === id);
  if (!problem?.judgeUrl || !problem.statementUrl) throw new Error('Falta material del simulacro para ' + id);
  return { ...problem, judgeUrl: problem.judgeUrl };
});
const sources = tournaments.filter(tournament => set.some(problem => problem.tournamentId === tournament.id));
const referenceNotes = presetSelection('funciones', [...BASIC_CHUNK_IDS, 'cpp-strings', 'cpp-vectores', 'cpp-set', 'cpp-map'], chunks);
const setNotes = presetSelection('recomendado', recommendedChunkIds(set), chunks, notesLevel(set));
const noteChunks = chunks.filter(chunk => chunk.id in referenceNotes || chunk.id in setNotes);
---
<Layout title="Simulacro del miércoles" description="Vista de prueba de un simulacro del Club de Algoritmia UNT." noIndex>
  <SimulacroPreview problems={set} tournaments={sources} chunks={noteChunks} referenceNotes={referenceNotes} setNotes={setNotes} client:load/>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import {problems,tournaments} from '../../lib/data';
export function getStaticPaths(){return tournaments.map(tournament=>({params:{id:tournament.id},props:{tournament}}));}
const {tournament:t}=Astro.props;
const set=problems.filter(p=>p.tournamentId===t.id).sort((a,b)=>(b.ac??-1)-(a.ac??-1));
const maxTeams=Math.max(...t.distribution.map(row=>row.teams),1);
---
<Layout title={t.title}><div class="breadcrumb"><a href="/torneos/">Torneos</a> / {t.year}</div><div class="page-heading"><span class="eyebrow">{t.season} / Datos {t.status === 'verificado' ? 'verificados' : t.status}</span><h1>{t.title}</h1><p class="muted">{t.setName}</p></div><div class="stats-row"><div class="stat"><strong>{t.totalTeams??'—'}</strong><span>equipos de la población indicada</span></div><div class="stat"><strong>{set.length}</strong><span>problemas en el inventario</span></div><div class="stat"><strong>{t.year}</strong><span>año calendario · temporada {t.season}</span></div></div><p class="notice"><strong>Población:</strong> {t.population}</p><div class="grid-two"><section class="panel"><span class="eyebrow">Standings / Distribución</span><h2>Cuántos equipos hicieron cuántos AC</h2>{t.distribution.length>0?t.distribution.slice().sort((a,b)=>a.solved-b.solved).map(row=><div class="bar-row"><span>{row.solved} {row.solved===1?'problema':'problemas'}</span><div class="bar-track"><div class="bar-fill" style={`width:${row.teams/maxTeams*100}%`}/></div><strong>{row.teams}</strong></div>):<p class="muted">Distribución pendiente de verificar.</p>}<p class="muted"><small>Cada equipo se cuenta una sola vez, según su cantidad final de problemas resueltos.</small></p></section><aside class="panel"><span class="eyebrow">Lectura del torneo</span><h2>Notas y contexto</h2>{t.notes.map(note=><p>{note}</p>)}<p class="muted"><small>Un AC aislado no determina un puesto. La clasificación también depende del ranking, la penalización y las reglas de ese torneo.</small></p></aside></div><section><div class="section-title"><h2>La curva del set</h2><span class="eyebrow">De más a menos equipos con AC</span></div><div class="table-wrap"><table><thead><tr><th>Problema</th><th>AC / total</th><th>Nivel editorial</th><th class="desktop-only">Temas</th></tr></thead><tbody>{set.map(p=><tr><td><a class="problem-title" href={`/problemas/${p.id}/`}>{p.letter} · {p.title}</a></td><td class="ac">{p.ac??'—'} / {p.total??'—'}</td><td><span class="chip" data-level={p.difficulty}>{p.difficulty}</span></td><td class="desktop-only">{p.topics.join(', ')}</td></tr>)}</tbody></table></div></section><div class="grid-two"><section class="panel" aria-label="Resultados de Tucumán"><h2>Resultados de Tucumán</h2>{t.tucumanResults.length?t.tucumanResults.map(result=><article class:list={['local-result', {qualified: !!result.qualifiedTo}]}><span class="chip">{result.institution}</span><h3>{result.team}</h3>{result.qualifiedTo&&<span class="qualification-badge">✓ Clasificó a {result.qualifiedTo}</span>}<p>{result.solved} AC{result.rank!==null?` · puesto ${result.rank}`:''}</p><p class="muted">{result.note}</p></article>):<p class="muted">Resultados de los equipos de Tucumán pendientes de verificar.</p>}</section><section class="panel"><h2>Fuentes del torneo</h2><ul class="note-list">{t.sources.map(source=><li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul></section></div></Layout>

---
import Layout from '../../layouts/Layout.astro';
import TournamentProblems from '../../components/TournamentProblems';
import { problems, tournaments } from '../../lib/data';
export function getStaticPaths() {
  return tournaments.map(tournament => ({ params: { id: tournament.id }, props: { tournament } }));
}
const { tournament: t } = Astro.props;
const set = problems.filter(problem => problem.tournamentId === t.id).sort((a, b) => (b.ac ?? -1) - (a.ac ?? -1));
const maxTeams = Math.max(...t.distribution.map(row => row.teams), 1);
const institutions = [...new Set(t.tucumanResults.map(result => result.institution))];
const institutionNames: Record<string, string> = {
  UNT: 'Universidad Nacional de Tucumán',
  'UTN-FRT': 'UTN · Facultad Regional Tucumán',
  UNSTA: 'Universidad del Norte Santo Tomás de Aquino',
};
const qualified = t.tucumanResults.filter(result => result.qualifiedTo);
const gym = t.judgeUrl?.match(/^https:\/\/codeforces\.com\/gym\/(\d+)\/?$/);
const qualification = t.qualification;
---
<Layout title={t.title}>
  <div class="breadcrumb"><a href="/torneos/">Torneos</a> / {t.year}</div>
  <div class="page-heading">
    <h1>{t.title}</h1>
    {gym && <p class="muted tournament-judge"><span>Gym {gym[1]} · {set.length} problemas</span><a class="external-link" href={t.judgeUrl} target="_blank" rel="noreferrer" aria-label={`Abrir Gym ${gym[1]} en Codeforces (nueva pestaña)`} title="Abrir en Codeforces"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7M21 3 10 14"/><path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5"/></svg></a></p>}
  </div>
  <div class="stats-row">
    <div class="stat" title={t.population}><strong>{t.totalTeams ?? '—'}</strong><span>equipos participantes</span></div>
    <div class="stat"><strong>{qualification?.count ?? '—'}</strong><span>{qualification ? `${qualification.kind} ${qualification.scope} al ${qualification.target}` : 'clasificados totales por verificar'}</span></div>
    <div class="stat"><strong>{qualified.length || '—'}</strong><span>clasificados de Tucumán{t.id.startsWith('tap-') ? ' al Regional' : ' a la siguiente instancia'}</span></div>
  </div>

  <section class="panel">
    <span class="eyebrow">Standings / Distribución</span>
    <h2>Cuántos equipos hicieron cuántos AC</h2>
    {t.distribution.length > 0 ? t.distribution.slice().sort((a,b) => a.solved-b.solved).map(row =>
      <div class="bar-row"><span>{row.solved} {row.solved === 1 ? 'problema' : 'problemas'}</span><div class="bar-track"><div class="bar-fill" style={`width:${row.teams/maxTeams*100}%`}/></div><strong>{row.teams}</strong></div>
    ) : <p class="muted">Distribución pendiente de verificar.</p>}
  </section>

  <section>
    <div class="section-title"><h2>La curva del set</h2><span class="eyebrow">De más a menos equipos con AC</span></div>
    <TournamentProblems problems={set} allowed={problems.map(problem => problem.id)} client:load/>
  </section>

  <section class="local-results-section" aria-label="Resultados de Tucumán">
    <div class="section-title"><h2>Resultados de Tucumán</h2></div>
    {institutions.length > 0 ? <div class="university-results">{institutions.map(institution =>
      <section class="panel university-group" aria-label={institution}>
        <header><h3>{institution}</h3><p class="muted">{institutionNames[institution] ?? institution}</p></header>
        {t.tucumanResults.filter(result => result.institution === institution).map(result =>
          <article class:list={['local-result', { qualified: !!result.qualifiedTo }]}>
            <div class="result-heading"><h4>{result.team}</h4>{result.qualifiedTo && <span class="qualification-badge" title={result.qualifiedTo} aria-label={`Clasificó a ${result.qualifiedTo}`}>✓ Clasificó</span>}</div>
            <p class="result-metrics"><span>Puesto: <strong>{result.rank ?? '—'}</strong></span><span>AC: <strong>{result.solved}</strong></span><span>Penalidad: <strong>{result.penalty ?? '—'}</strong></span></p>
            <div class="solved-problems"><span>Problemas resueltos:</span>{result.solvedProblems?.length ? result.solvedProblems.map(letter => <a href={`/problemas/${t.id}-${letter.toLowerCase()}/`}>{letter}</a>) : <span class="muted">{result.solved === 0 ? 'Ninguno' : 'Por verificar'}</span>}</div>
          </article>
        )}
      </section>
    )}</div> : <p class="panel muted">Resultados de los equipos de Tucumán pendientes de verificar.</p>}
  </section>

  <section class="panel tournament-sources">
    <h2>Fuentes del torneo</h2>
    <ul class="note-list">{t.sources.map(source => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul>
  </section>
</Layout>

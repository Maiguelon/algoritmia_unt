---
import Layout from '../../layouts/Layout.astro';
import {tournaments,problems} from '../../lib/data';
---
<Layout title="Torneos"><div class="page-heading"><h1>Analizá cada torneo</h1><p class="muted">¿Qué problemas se tomaron? ¿Qué temas aparecieron? ¿Qué hacía falta para clasificar ese año? Explorá cada edición y sus resultados.</p></div><div class="grid-three">{tournaments.map(t=><a class="link-card" href={`/torneos/${t.id}/`}><h2>{t.title}</h2><p>{t.status === 'pendiente' ? 'Set y estadísticas pendientes de incorporación' : `${problems.filter(p=>p.tournamentId===t.id).length} problemas · ${t.totalTeams ?? 'Sin dato de'} equipos`}</p><span>Explorar torneo ↗</span></a>)}</div></Layout>
